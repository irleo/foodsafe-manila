PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/foodsafe-manila

ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret

NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5100

BREVO_API_KEY=
BREVO_FROM_EMAIL=account@foodsafe-manila.online
BREVO_FROM_NAME=FoodSafe Manila

# Email Templates
BREVO_ACCESS_OTP_TEMPLATE_ID=2
BREVO_RESET_OTP_TEMPLATE_ID=3

# Semaphore (mobile verification codes)
SEMAPHORE_API_KEY=

# Optional. Leave blank to use the default active Sender Name on the account.
SEMAPHORE_SENDER_NAME=
SEMAPHORE_SMS_API_URL=https://api.semaphore.co/api/v4/messages
OTP_HASH_SECRET=change-me-mobile-otp-secret

# Private Cloudflare R2 dataset storage (backend only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=foodsafe-datasets
